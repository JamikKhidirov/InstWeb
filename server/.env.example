# ============================================================
#  Pixora API — пример конфигурации
#  Скопируйте файл в server/.env и заполните значения.
#  Файл .env НИКОГДА не коммитится в git.
# ============================================================

# --- Сервер ---
PORT=4000
NODE_ENV=development

# Секрет для подписи JWT. Сгенерировать:
#   openssl rand -hex 32
JWT_SECRET=please_change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Откуда разрешены запросы к API (через запятую).
# В dev это Vite, в проде — ваш домен.
CLIENT_ORIGIN=http://localhost:5173,https://example.com

# true, если сервер стоит за nginx (нужно для корректного IP в Telegram)
TRUST_PROXY=true

# Отдавать собранный фронтенд (client/dist) прямо из Node.
# true — удобный деплой «одним сервисом»; false — если статику отдаёт nginx.
SERVE_STATIC=true

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата/канала/группы, куда присылать уведомления
TELEGRAM_CHAT_ID=
# true/false — выключить уведомления, не трогая токен
TELEGRAM_ENABLED=true

# Часовой пояс для времени в сообщении
TZ_NAME=Europe/Moscow

# Определять город по IP (внешний сервис ip-api.com, бесплатный лимит).
# false — в сообщении будет только IP.
GEOIP_ENABLED=false

# --- Данные ---
# Каталог для users.json (относительно папки server)
DATA_DIR=./data
